---
import { useTranslations } from '../i18n/utils';
import type { Lang } from '../i18n/ui';
import { services } from '../data/data';

interface Props {
	lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);

const accentClasses = {
	primary: { border: 'hover:border-primary/50', iconBg: 'bg-primary/10', iconText: 'text-primary' },
	tertiary: { border: 'hover:border-tertiary/50', iconBg: 'bg-tertiary/10', iconText: 'text-tertiary' },
};
---

<section class="py-section-gap px-margin-mobile md:px-gutter relative bg-surface-container-low" id="services">
	<div class="max-w-container-max mx-auto">
		<div class="flex items-center gap-4 mb-12">
			<h2 class="font-headline-md text-headline-md text-primary">{t('services.title')}</h2>
			<div class="h-px bg-outline-variant/30 flex-grow max-w-md"></div>
		</div>
		<p class="font-body-lg text-body-lg text-on-surface-variant max-w-2xl mb-12">{t('services.subtitle')}</p>
		<div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-8">
			{services.map((service) => {
				const accent = accentClasses[service.accent];
				return (
					<div
						class={`bg-surface-container p-8 rounded-xl border border-outline-variant/20 ${accent.border} hover:-translate-y-2 transition-all duration-300 flex flex-col`}
					>
						<div class={`w-14 h-14 rounded-xl ${accent.iconBg} flex items-center justify-center mb-6`}>
							<span class={`material-symbols-outlined ${accent.iconText} text-3xl`}>{service.icon}</span>
						</div>
						<h3 class="font-headline-md text-xl text-on-surface mb-2">{service.title[lang]}</h3>
						<p class="font-body-md text-on-surface-variant flex-grow">{service.description[lang]}</p>
					</div>
				);
			})}
			<div class="bg-gradient-to-br from-[#a855f7] via-[#7c3aed] to-[#4c1d95] p-8 rounded-xl border border-outline-variant/20 flex flex-col justify-center items-start">
				<h3 class="font-headline-md text-xl text-on-primary-container mb-2">{t('services.cta.title')}</h3>
				<p class="font-body-md text-on-primary-container/90 mb-6">{t('services.cta.desc')}</p>
				<a
					class="px-6 py-3 bg-background text-primary rounded-full font-label-caps text-label-caps font-bold uppercase tracking-wider hover:bg-background/80 transition-all"
					href="#contact"
				>
					{t('services.cta.button')}
				</a>
			</div>
		</div>
	</div>
</section>
