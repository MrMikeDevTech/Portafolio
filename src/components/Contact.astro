---
import { useTranslations } from '../i18n/utils';
import type { Lang } from '../i18n/ui';
import { profile } from '../data/data';

interface Props {
	lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
const defaultMailto = `mailto:${profile.email}?subject=${encodeURIComponent(t('contact.mailFallbackSubject'))}`;
---

<section class="py-section-gap px-margin-mobile md:px-gutter relative" id="contact">
	<div class="max-w-container-max mx-auto">
		<div class="flex flex-col items-center text-center mb-12">
			<div class="flex items-center gap-4 justify-center w-full mb-4">
				<div class="h-px bg-outline-variant/30 w-16 md:w-32"></div>
				<h2 class="font-headline-md text-headline-md text-primary">{t('contact.title')}</h2>
				<div class="h-px bg-outline-variant/30 w-16 md:w-32"></div>
			</div>
			<p class="text-on-surface-variant font-body-lg max-w-2xl mt-4">{t('contact.subtitle')}</p>
		</div>
		<div class="max-w-2xl mx-auto bg-surface-container rounded-2xl p-8 border border-outline-variant/20 shadow-lg">
			<form
				class="space-y-6"
				id="contact-form"
				data-contact-email={profile.email}
				data-fallback-subject={t('contact.mailFallbackSubject')}
				data-label-name={t('contact.name')}
				data-label-email={t('contact.email')}
			>
				<div class="grid grid-cols-1 md:grid-cols-2 gap-6">
					<div>
						<label class="block text-sm font-label-code text-on-surface-variant mb-2" for="name">{t('contact.name')}</label>
						<input
							class="w-full bg-surface-container-low border border-outline-variant/30 rounded-lg px-4 py-3 text-on-surface focus:outline-none focus:border-primary focus:ring-1 focus:ring-primary transition-colors placeholder-on-surface-variant/50"
							id="name"
							placeholder="John Doe"
							type="text"
						/>
					</div>
					<div>
						<label class="block text-sm font-label-code text-on-surface-variant mb-2" for="email">{t('contact.email')}</label>
						<input
							class="w-full bg-surface-container-low border border-outline-variant/30 rounded-lg px-4 py-3 text-on-surface focus:outline-none focus:border-primary focus:ring-1 focus:ring-primary transition-colors placeholder-on-surface-variant/50"
							id="email"
							placeholder="john@example.com"
							type="email"
						/>
					</div>
				</div>
				<div>
					<label class="block text-sm font-label-code text-on-surface-variant mb-2" for="subject">{t('contact.subject')}</label>
					<input
						class="w-full bg-surface-container-low border border-outline-variant/30 rounded-lg px-4 py-3 text-on-surface focus:outline-none focus:border-primary focus:ring-1 focus:ring-primary transition-colors placeholder-on-surface-variant/50"
						id="subject"
						placeholder="Project Inquiry"
						type="text"
					/>
				</div>
				<div>
					<label class="block text-sm font-label-code text-on-surface-variant mb-2" for="message">{t('contact.message')}</label>
					<textarea
						class="w-full bg-surface-container-low border border-outline-variant/30 rounded-lg px-4 py-3 text-on-surface focus:outline-none focus:border-primary focus:ring-1 focus:ring-primary transition-colors placeholder-on-surface-variant/50 h-40 resize-none"
						id="message"
						placeholder="Hello, I'd like to discuss..."
					></textarea>
				</div>
				<a
					class="w-full py-4 bg-primary-container text-on-primary-container rounded-lg font-label-caps text-label-caps font-bold uppercase tracking-wider glow-effect glow-hover transition-all flex justify-center items-center gap-2"
					id="contact-send"
					href={defaultMailto}
				>
					<span>{t('contact.send')}</span>
					<span class="material-symbols-outlined text-sm">send</span>
				</a>
				<p class="text-xs text-on-surface-variant text-center">
					{t('contact.mailHint')} <a class="text-primary underline" href={`mailto:${profile.email}`}>{profile.email}</a>
				</p>
			</form>
		</div>
	</div>
</section>

<script>
	const form = document.getElementById('contact-form') as HTMLFormElement | null;
	const sendLink = document.getElementById('contact-send') as HTMLAnchorElement | null;

	function updateMailtoHref() {
		if (!form || !sendLink) return;

		const email = form.dataset.contactEmail ?? '';
		const fallbackSubject = form.dataset.fallbackSubject ?? '';
		const labelName = form.dataset.labelName ?? 'Name';
		const labelEmail = form.dataset.labelEmail ?? 'Email';

		const name = (document.getElementById('name') as HTMLInputElement | null)?.value.trim() ?? '';
		const senderEmail = (document.getElementById('email') as HTMLInputElement | null)?.value.trim() ?? '';
		const subjectField = (document.getElementById('subject') as HTMLInputElement | null)?.value.trim() ?? '';
		const message = (document.getElementById('message') as HTMLTextAreaElement | null)?.value.trim() ?? '';

		const subject = subjectField || fallbackSubject;
		const body = [`${labelName}: ${name || '-'}`, `${labelEmail}: ${senderEmail || '-'}`, '', message].join('\n');

		sendLink.href = `mailto:${email}?subject=${encodeURIComponent(subject)}&body=${encodeURIComponent(body)}`;
	}

	form?.addEventListener('input', updateMailtoHref);
	updateMailtoHref();
</script>
