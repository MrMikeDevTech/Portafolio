---
import { useTranslations } from '../i18n/utils';
import type { Lang } from '../i18n/ui';
import { profile } from '../data/data';

interface Props {
	lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);

const footerNav = [
	{ href: '#about', key: 'nav.about' as const },
	{ href: '#services', key: 'nav.services' as const },
	{ href: '#projects', key: 'nav.projects' as const },
	{ href: '#contact', key: 'nav.contact' as const },
];

const github = profile.socials.find((s) => s.icon === 'github')!;
const linkedin = profile.socials.find((s) => s.icon === 'linkedin')!;
---

<footer class="bg-surface-container-lowest border-t border-outline-variant/10 pt-16 pb-8">
	<div class="max-w-container-max mx-auto px-margin-mobile md:px-gutter w-full">
		<div class="grid grid-cols-1 md:grid-cols-4 gap-10 pb-12 border-b border-outline-variant/10">
			<div class="md:col-span-2 space-y-4">
				<a class="flex items-center gap-2 font-display-lg text-headline-md text-primary tracking-tight" href={`/${lang}/`}>
					<img src={profile.logo} alt="MrMikeDev Studio logo" class="w-9 h-9 rounded-lg" width="36" height="36" />
					<span>MrMikeDev Studio</span>
				</a>
				<p class="text-on-surface-variant font-body-md text-sm max-w-sm">{t('footer.tagline')}</p>
				<div class="flex gap-3 pt-2">
					<a
						class="w-10 h-10 rounded-full border border-outline-variant/30 flex items-center justify-center text-on-surface-variant hover:text-primary hover:border-primary/50 transition-colors"
						href={github.href}
						target="_blank"
						rel="noopener noreferrer"
						aria-label="GitHub"
					>
						<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" width="18" height="18" fill="currentColor"
							><path d="M12 .5C5.73.5.98 5.24.98 11.52c0 5.02 3.26 9.28 7.78 10.78.57.1.78-.25.78-.55 0-.27-.01-1.17-.02-2.12-3.17.69-3.84-1.35-3.84-1.35-.52-1.32-1.27-1.67-1.27-1.67-1.04-.71.08-.7.08-.7 1.15.08 1.76 1.18 1.76 1.18 1.02 1.75 2.68 1.25 3.33.95.1-.74.4-1.25.72-1.54-2.53-.29-5.19-1.27-5.19-5.63 0-1.24.44-2.26 1.17-3.06-.12-.29-.51-1.46.11-3.04 0 0 .96-.31 3.14 1.17a10.9 10.9 0 0 1 5.72 0c2.18-1.48 3.14-1.17 3.14-1.17.62 1.58.23 2.75.11 3.04.73.8 1.17 1.82 1.17 3.06 0 4.37-2.67 5.33-5.21 5.62.41.36.78 1.07.78 2.16 0 1.56-.01 2.82-.01 3.2 0 .31.2.66.79.55a11.03 11.03 0 0 0 7.77-10.78C23.02 5.24 18.27.5 12 .5Z"
							></path></svg
						>
					</a>
					<a
						class="w-10 h-10 rounded-full border border-outline-variant/30 flex items-center justify-center text-on-surface-variant hover:text-primary hover:border-primary/50 transition-colors"
						href={linkedin.href}
						target="_blank"
						rel="noopener noreferrer"
						aria-label="LinkedIn"
					>
						<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" width="18" height="18" fill="currentColor"
							><path d="M20.45 20.45h-3.56v-5.57c0-1.33-.02-3.04-1.85-3.04-1.86 0-2.14 1.45-2.14 2.94v5.67H9.34V9h3.41v1.56h.05c.48-.9 1.64-1.85 3.37-1.85 3.6 0 4.27 2.37 4.27 5.46v6.28ZM5.34 7.43a2.07 2.07 0 1 1 0-4.14 2.07 2.07 0 0 1 0 4.14ZM7.12 20.45H3.56V9h3.56v11.45ZM22.22 0H1.77C.8 0 0 .78 0 1.75v20.5C0 23.22.8 24 1.77 24h20.45c.98 0 1.78-.78 1.78-1.75V1.75C24 .78 23.2 0 22.22 0Z"
							></path></svg
						>
					</a>
					<a
						class="w-10 h-10 rounded-full border border-outline-variant/30 flex items-center justify-center text-on-surface-variant hover:text-primary hover:border-primary/50 transition-colors"
						href={`mailto:${profile.email}`}
						aria-label="Email"
					>
						<span class="material-symbols-outlined text-lg">mail</span>
					</a>
				</div>
			</div>
			<div>
				<h4 class="font-label-caps text-label-caps uppercase tracking-widest text-on-surface mb-4">{t('footer.nav')}</h4>
				<ul class="space-y-3 text-sm">
					{footerNav.map((item) => (
						<li>
							<a class="text-on-surface-variant hover:text-primary transition-colors" href={item.href}>
								{t(item.key)}
							</a>
						</li>
					))}
				</ul>
			</div>
			<div>
				<h4 class="font-label-caps text-label-caps uppercase tracking-widest text-on-surface mb-4">{t('footer.contact')}</h4>
				<ul class="space-y-3 text-sm">
					<li>
						<a class="text-on-surface-variant hover:text-primary transition-colors" href={`mailto:${profile.email}`}>
							{t('footer.email')}
						</a>
					</li>
					<li>
						<a class="text-on-surface-variant hover:text-primary transition-colors" href={github.href} target="_blank" rel="noopener noreferrer">
							GitHub
						</a>
					</li>
					<li>
						<a class="text-on-surface-variant hover:text-primary transition-colors" href={linkedin.href} target="_blank" rel="noopener noreferrer">
							LinkedIn
						</a>
					</li>
				</ul>
			</div>
		</div>
		<div class="flex items-center justify-center pt-8">
			<div class="text-on-surface-variant font-body-md text-sm text-center">
				© <span id="footer-year">2026</span> MrMikeDev Studio. {t('footer.rights')}
			</div>
		</div>
	</div>
</footer>

<script>
	const footerYear = document.getElementById('footer-year');
	if (footerYear) footerYear.textContent = String(new Date().getFullYear());
</script>
