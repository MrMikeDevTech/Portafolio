---
import { useTranslations } from '../i18n/utils';
import type { Lang } from '../i18n/ui';

interface Props {
	lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
---

<div
	class="fixed inset-0 z-[60] bg-background/80 backdrop-blur-sm hidden items-center justify-center p-4 transition-opacity duration-300 opacity-0"
	id="project-modal"
>
	<div
		class="bg-surface-container w-full max-w-4xl rounded-2xl border border-outline-variant/20 shadow-2xl overflow-hidden flex flex-col max-h-[90vh] scale-95 transition-transform duration-300"
		id="modal-content"
	>
		<div class="relative h-64 md:h-96 bg-surface-container-lowest flex-shrink-0 group">
			<div class="flex overflow-x-auto snap-x snap-mandatory h-full no-scrollbar" id="modal-carousel"></div>
			<button
				class="absolute top-4 right-4 w-10 h-10 bg-background/50 backdrop-blur-md rounded-full flex items-center justify-center text-on-surface hover:bg-background/80 transition-colors z-10"
				id="modal-close"
				aria-label="Close"
			>
				<span class="material-symbols-outlined">close</span>
			</button>
			<button
				class="absolute left-4 top-1/2 -translate-y-1/2 w-10 h-10 bg-background/50 backdrop-blur-md rounded-full flex items-center justify-center text-on-surface hover:bg-background/80 transition-colors opacity-0 group-hover:opacity-100"
				id="modal-prev"
				aria-label="Previous image"
			>
				<span class="material-symbols-outlined">chevron_left</span>
			</button>
			<button
				class="absolute right-4 top-1/2 -translate-y-1/2 w-10 h-10 bg-background/50 backdrop-blur-md rounded-full flex items-center justify-center text-on-surface hover:bg-background/80 transition-colors opacity-0 group-hover:opacity-100"
				id="modal-next"
				aria-label="Next image"
			>
				<span class="material-symbols-outlined">chevron_right</span>
			</button>
		</div>
		<div class="p-8 overflow-y-auto">
			<div class="flex flex-col md:flex-row md:justify-between md:items-end gap-4 mb-6">
				<div>
					<h3 class="font-headline-md text-3xl text-primary" id="modal-title">Project Title</h3>
					<p class="font-label-code text-on-surface-variant mt-2" id="modal-subtitle">Web Application</p>
				</div>
				<div class="flex gap-4">
					<a
						class="flex items-center gap-2 px-4 py-2 bg-primary text-on-primary rounded-lg hover:bg-primary/90 transition-colors text-sm font-label-caps uppercase"
						href="#"
						id="modal-github"
						target="_blank"
						rel="noopener noreferrer"
					>
						<span class="material-symbols-outlined text-sm">code</span> <span>{t('modal.repo')}</span>
					</a>
				</div>
			</div>
			<div class="prose prose-invert max-w-none text-on-surface-variant font-body-md space-y-4 mb-8" id="modal-description">
				<p>Detailed project description goes here.</p>
			</div>
			<div>
				<h4 class="font-label-caps text-on-surface uppercase tracking-widest mb-4">{t('modal.techStack')}</h4>
				<div class="flex flex-wrap gap-3" id="modal-tech"></div>
			</div>
		</div>
	</div>
</div>

<script>
	const modal = document.getElementById('project-modal');
	const modalContent = document.getElementById('modal-content');
	const carousel = document.getElementById('modal-carousel');

	function openModal(data: { title: string; subtitle: string; description: string; images: string[]; tech: string[]; github: string }) {
		if (!modal || !modalContent || !carousel) return;

		const titleEl = document.getElementById('modal-title');
		const subtitleEl = document.getElementById('modal-subtitle');
		const descEl = document.getElementById('modal-description');
		const githubEl = document.getElementById('modal-github') as HTMLAnchorElement | null;
		const techEl = document.getElementById('modal-tech');

		if (titleEl) titleEl.textContent = data.title;
		if (subtitleEl) subtitleEl.textContent = data.subtitle;
		if (descEl) descEl.innerHTML = data.description;
		if (githubEl) githubEl.href = data.github;

		carousel.innerHTML = data.images
			.map((src) => `<img src="${src}" class="w-full h-full object-cover snap-center flex-shrink-0" alt="${data.title} screenshot">`)
			.join('');

		if (techEl) {
			techEl.innerHTML = data.tech
				.map(
					(tech) =>
						`<span class="px-3 py-1.5 bg-surface-variant text-on-surface-variant text-sm rounded-md font-label-code border border-outline-variant/30 flex items-center gap-2"><span class="w-2 h-2 rounded-full bg-primary"></span>${tech}</span>`
				)
				.join('');
		}

		modal.classList.remove('hidden');
		modal.classList.add('flex');
		setTimeout(() => {
			modal.classList.remove('opacity-0');
			modalContent.classList.remove('scale-95');
		}, 10);

		document.body.style.overflow = 'hidden';
	}

	function closeModal() {
		if (!modal || !modalContent) return;
		modal.classList.add('opacity-0');
		modalContent.classList.add('scale-95');

		setTimeout(() => {
			modal.classList.add('hidden');
			modal.classList.remove('flex');
			document.body.style.overflow = '';
		}, 300);
	}

	function scrollCarousel(direction: number) {
		if (!carousel) return;
		const scrollAmount = carousel.clientWidth * direction;
		carousel.scrollBy({ left: scrollAmount, behavior: 'smooth' });
	}

	document.querySelectorAll('.project-view-details').forEach((button) => {
		button.addEventListener('click', (e) => {
			const target = e.currentTarget as HTMLElement;
			const { projectTitle, projectSubtitle, projectDescription, projectImages, projectTech, projectGithub } = target.dataset;
			if (!projectTitle) return;
			openModal({
				title: projectTitle,
				subtitle: projectSubtitle ?? '',
				description: projectDescription ?? '',
				images: projectImages ? JSON.parse(projectImages) : [],
				tech: projectTech ? JSON.parse(projectTech) : [],
				github: projectGithub ?? '#',
			});
		});
	});

	document.getElementById('modal-close')?.addEventListener('click', closeModal);
	document.getElementById('modal-prev')?.addEventListener('click', () => scrollCarousel(-1));
	document.getElementById('modal-next')?.addEventListener('click', () => scrollCarousel(1));

	modal?.addEventListener('click', (e) => {
		if (e.target === modal) closeModal();
	});
</script>
