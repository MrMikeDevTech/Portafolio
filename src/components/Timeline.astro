---
import { useTranslations } from '../i18n/utils';
import type { Lang } from '../i18n/ui';
import { timeline } from '../data/data';

interface Props {
	lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);

const accentDot = {
	primary: 'bg-primary',
	tertiary: 'bg-tertiary',
};
const accentText = {
	primary: 'text-primary',
	tertiary: 'text-tertiary',
};
const accentBorderHover = {
	primary: 'hover:border-primary/30',
	tertiary: 'hover:border-tertiary/30',
};
---

<section class="py-section-gap px-margin-mobile md:px-gutter relative" id="timeline">
	<div class="max-w-container-max mx-auto">
		<div class="flex items-center gap-4 mb-12">
			<h2 class="font-headline-md text-headline-md text-primary">{t('timeline.title')}</h2>
			<div class="h-px bg-outline-variant/30 flex-grow max-w-md"></div>
		</div>
		<div class="relative ml-4 md:ml-0">
			<div class="absolute left-0 md:left-1/2 top-0 bottom-0 w-0.5 bg-outline-variant/30 -translate-x-1/2 hidden md:block"></div>
			<div class="absolute left-0 top-0 bottom-0 w-0.5 bg-outline-variant/30 md:hidden"></div>
			<div class="space-y-12 relative">
				{timeline.map((entry, i) => {
					const isEven = i % 2 === 0;
					return (
						<div class="relative flex flex-col md:flex-row md:justify-between items-start md:items-center w-full group">
							<div
								class={`absolute left-[-5px] md:left-1/2 w-3 h-3 ${accentDot[entry.accent]} rounded-full md:-translate-x-1/2 mt-2 md:mt-0 ring-4 ring-background group-hover:scale-150 transition-transform z-10`}
							/>
							<div
								class={
									isEven
										? 'ml-8 md:ml-0 md:w-[45%] md:text-right md:pr-12'
										: 'ml-8 md:ml-0 md:w-[45%] md:order-2 md:pl-12'
								}
							>
								<h3 class="font-headline-md text-xl text-on-surface">{entry.title[lang]}</h3>
								<p class={`${accentText[entry.accent]} font-label-caps uppercase tracking-widest mt-1`}>{entry.institution}</p>
								<p class="text-on-surface-variant text-sm mt-2">{entry.period[lang]}</p>
							</div>
							<div
								class={
									isEven
										? 'ml-8 md:ml-0 mt-4 md:mt-0 md:w-[45%] md:pl-12'
										: 'ml-8 md:ml-0 mt-4 md:mt-0 md:w-[45%] md:order-1 md:text-right md:pr-12'
								}
							>
								<div class={`bg-surface-container p-6 rounded-lg border border-outline-variant/20 ${accentBorderHover[entry.accent]} transition-colors`}>
									<p class="text-on-surface-variant text-body-md">{entry.description[lang]}</p>
								</div>
							</div>
						</div>
					);
				})}
			</div>
		</div>
	</div>
</section>
