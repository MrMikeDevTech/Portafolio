---
import BaseLayout from '../layouts/BaseLayout.astro';
import { profile } from '../data/data';
---

<BaseLayout lang="en" title="404 - MrMikeDev Studio" description="Page not found.">
	<main class="min-h-screen flex items-center justify-center px-margin-mobile">
		<div class="text-center max-w-md space-y-6">
			<div class="flex items-center justify-center w-20 h-20 rounded-2xl bg-primary-container text-on-primary-container mx-auto">
				<span class="material-symbols-outlined text-4xl">search_off</span>
			</div>
			<h1 class="font-headline-md text-headline-md text-on-background">404</h1>
			<p class="font-body-lg text-body-lg text-on-surface-variant">
				This page doesn't exist. / Esta página no existe.
			</p>
			<div class="flex items-center justify-center gap-4 pt-2">
				<a
					class="px-6 py-3 bg-primary-container text-on-primary-container rounded-full font-label-caps text-label-caps font-bold uppercase tracking-wider glow-effect glow-hover transition-all"
					href="/en/"
				>
					EN
				</a>
				<a
					class="px-6 py-3 border border-outline-variant/30 text-on-surface rounded-full font-label-caps text-label-caps font-bold uppercase tracking-wider hover:bg-primary/10 transition-all"
					href="/es/"
				>
					ES
				</a>
			</div>
			<p class="text-on-surface-variant text-sm">
				<a class="hover:text-primary transition-colors" href={`mailto:${profile.email}`}>{profile.email}</a>
			</p>
		</div>
	</main>
</BaseLayout>
